# Function to adjust SM2 wrap target to not compete with SM0 on status
# worked example expects offset of +8 to be added to WRAP_BOTTOM
def adjust_sm2_wrap_target(offset):
    offset = offset & 0xf # limit to max 15 for safety
    # PIO0 base address (for the first PIO instance, PIO0)
    PIO0_BASE = 0x50200000
    SM2_EXECCTRL_OFFSET = 0x0fc # wrap field base [11:7] WRAP_BOTTOM
    execctrl = mem32[PIO0_BASE + SM2_EXECCTRL_OFFSET]
    mem32[PIO0_BASE + SM2_EXECCTRL_OFFSET] = execctrl + (offset << 7)
# global copy of virtual channel flags
xiot_vcflags = 0b1111
verbose = False
def sm2irq_handler(sm2):
    rx12=sm2.get()
    chan1 = (rx12 & 0x200) != 0
    read = (rx12 & 0x100) == 0
    data = rx12 & 0xff
    if (verbose and read and chan1):
        print(f"XIOT:SM2IRQ C:{chan1}, R:{read}, D:{data:02x}")
    if (read and (chan1 == True)):
        print("[",chr(data),"]",sep='',end='')
sm2.irq(sm2irq_handler)
def sm0irq_handler(sm0):
    rx12=sm0.get()
    chan1 = ((rx12 & 0x200) != 0)
    read = ((rx12 & 0x100) == 0)
    data = (rx12 & 0xff)
    if (verbose):
        print(f"XIOT:SM0IRQ C:{chan1}, R:{read}, D:{data:02x}")
    if (read and (chan1 == False)):
        #print("{",chr(data),"}",sep='',end='')
        sys.stdout.write(chr(data))
sm0.irq(sm0irq_handler)
# Function to get target FIFO status
#From controller perspective:
#   FIFO_status[3:0] = { tx1, rx1, tx0, rx0}
#   Controller interprets as (tx1 empty, rx1_full, tx0 empty, rx0_full)
# so we need (rx)
#    fifo_status = rx1_not_empty << 3 | tx1_full << 2 | rx2_not_empty << 1 | tx2_full
def get_xiot_fifo_status():
    fifo_flags = 0b1111
    if sm0.rx_fifo() <= 2: # RX channels share SM0
        fifo_flags = fifo_flags & 0b0101
    if sm1.tx_fifo() > 0 :
        fifo_flags = fifo_flags & 0b1110
    if sm3.tx_fifo() > 0:
        fifo_flags = fifo_flags & 0b1011
    #print("XIOT fifo_status is:", fifo_flags)
    return fifo_flags
# Function to update target FIFO status
def update_xiot_fifo_status():
    # global copy of virtual channel flags
    global xiot_vcflags
    xiot_vcflags = get_xiot_fifo_status()
    sm0.put(xiot_vcflags)
    return 
def xiot_xfer_check():
    return(sm0.rx_fifo() > 0)
def get_xioc_channel_status():
    sm5.put(1) # dummy write to trigger sm5
    fifo_status = sm5.get() # return status bits [3:0]
    return(fifo_status)
def report_xioc_channel_status():
    fifo_status = get_xioc_channel_status()
    print("XIOC sm5 fifo_status is:", fifo_status)
    return
# SM4 is XIOC used to send requests
# only call these if the virtual channel is not blocked
def xioc_tx0(txbyte):
    sm4.put(0x0f00 + (txbyte & 0xff)) # channel 0, 0b1111 pindir mask
    return(sm4.get())
def xioc_tx1(txbyte):
    sm4.put(0x2f00 + (txbyte & 0xff)) # channel 1, 0b1111 pindir mask
    return(sm4.get())
def xioc_rx0( ):  # channel 0, 0b0000 pindir mask
    sm4.put(0x1000)
    return(sm4.get())
def xioc_rx1( ):
    sm4.put(0x3000)  # channel 1, 0b0000 pindir mask
    return(sm4.get())
def xiot_xfer_check():
    return(sm0.rx_fifo() > 0)
def xiot_xfer_report(rx12):
    chan = (rx12 & 0x200) != 0
    read = (rx12 & 0x100) != 0
    char = rx12 & 0xff
    print(f"XIOT C:{chan}, R:{read}, D:{char:02x}")
    return(rx12)
# XIOT tx0->rx0 - SM1 FIFO/SM
def xiot_tx0(txbyte):  # host channel 0 tx
    global xiot_vcflags
    if txbyte == 0x5d: # remap ']'
        txbyte = 0x1b # to ESC
    sm1.put(txbyte<<24)
    xiot_vcflags = get_xiot_fifo_status() & 0b1101
    sm0.put(xiot_vcflags)
    return(xiot_vcflags)
# XIOT tx1->rx1 - SM3 FIFO/SM
def xiot_tx1(txbyte):  # host channel 1 tx
    global xiot_vcflags
    sm3.put(txbyte<<24)
    xiot_vcflags = get_xiot_fifo_status() & 0b0111
    sm0.put(xiot_vcflags)
    return(xiot_vcflags)
